# ============================================================
#  Authentik HA Cluster Monitor — Site Configuration
#  Emitted by akropolis handoff for site: {{ site_name }}
#  Generated {{ generated_at }} — hand-edits survive until the next handoff run.
# ============================================================

site_name: "{{ site_title }}"

unicode_bullets: true
refresh_interval: 20
http_timeout: 5

# VIP managed by keepalived
vip: "{{ vip }}"

# Network interface keepalived runs on (used for display only)
vrrp_interface: "{{ interface }}"

nodes:
  authentik:
{% for n in nodes %}
    - ip: "{{ n.ip }}"
      name: "{{ n.name }}"
{% endfor %}

  patroni:
{% for n in nodes %}
    - ip: "{{ n.ip }}"
      name: "{{ n.name }}"
{% endfor %}

  etcd:
{% for n in nodes %}
    - ip: "{{ n.ip }}"
      name: "{{ n.name }}"
{% endfor %}

  haproxy:
{% for n in nodes %}
    - ip: "{{ n.ip }}"
      name: "{{ n.name }}"
{% endfor %}

ports:
  # Authentik SERVER, HTTPS listener. Present regardless of tls.provider —
  # AUTHENTIK_LISTEN__HTTPS is always set, so this is self-signed on a
  # tls: none site and still answers /-/health/live/ and /-/health/ready/.
  authentik: {{ authentik_port }}
  # Authentik WORKER liveness — a SEPARATE port (9081), never 9443: the
  # worker binds its own HTTP listener so it does not squat the server's.
  # Probing the worker on 9443 reaches the server, which makes a dead
  # worker look alive.
  authentik_worker: 9081
  patroni: 8008
  etcd: 2379
  haproxy_stats: 9000
  nginx_status: 8080
  postgres: 5432

# Scheme + port for the per-node nginx `/monitor` identity endpoint and the
# Authentik health probes. On a tls: none site nginx serves plain HTTP on :80,
# so an https:// probe fails outright and every node shows DOWN.
scheme:
  nginx: "{{ nginx_scheme }}"          # probe {{ nginx_scheme }}://<node-ip>/monitor
  nginx_port: {{ nginx_port }}
  authentik: "https"                   # server health is HTTPS on {{ authentik_port }}
  authentik_worker: "http"             # worker liveness is plain HTTP on 9081
  # Emitted false always, whatever tls.provider is. The two probes this
  # setting governs — the per-node /monitor above and the VIP holder check —
  # are addressed by IP, because identifying an individual node is the whole
  # point of them and the hostname resolves to one address, not three. No
  # certificate this cluster can hold names 10.x, so `true` fails the
  # handshake on every node and the monitor reports nginx down, keepalived
  # FAULT and the VIP unreachable on a perfectly healthy cluster. Nothing is
  # lost: the probes carrying the API token already go out unverified.
  # Set true only if your nodes present certs that name what you dial here
  # (an internal CA with IP SANs, or node entries that are DNS names).
  verify_tls: {{ 'true' if verify_tls else 'false' }}

ssh:
  username: "{{ ssh_user }}"
  key_file: "{{ ssh_key_file }}"

# Services to collect logs from.
# type: "docker" (container name) or "systemd" (unit name)
# nodes: key from the nodes/keepalived sections above that lists the target hosts
services:
  - label: "Auth Server"
    nodes: authentik
    type: docker
    container: "authentik-server-1"
  - label: "Auth Worker"
    nodes: authentik
    type: docker
    container: "authentik-worker-1"
  - label: "Patroni"
    nodes: patroni
    type: systemd
    unit: "patroni"
  - label: "etcd"
    nodes: etcd
    type: docker
    container: "etcd"
  - label: "HAProxy"
    nodes: haproxy
    type: docker
    container: "haproxy"
  - label: "Nginx"
    nodes: authentik
    type: docker
    container: "nginx"
  - label: "Keepalived"
    nodes: keepalived
    type: systemd
    unit: "keepalived"

authentik:
  url: "{{ authentik_url }}"

credentials:
  haproxy_stats_user: "admin"
  haproxy_stats_pass: "{{ haproxy_stats_pass }}"
  authentik_api_token: "{{ api_token }}"
  postgres_user: "postgres"
  postgres_password: "{{ postgres_password }}"

keepalived:
  # Base priorities per node — matches what akropolis deployed in keepalived.conf
  # (effective = base + track_weight when nginx is down)
  track_weight: -25
  nodes:
{% for n in nodes %}
    - ip: "{{ n.ip }}"
      name: "{{ n.name }}"
      base_priority: {{ priorities[loop.index0] }}
{% endfor %}
{% if cert_expiry %}

# NOTE: tls provider 'import' has no auto-renewal — certificate expires {{ cert_expiry }}.
# ak-monitor has no cert-expiry field yet; consider adding one (see akropolis NOTES.md).
{% endif %}
