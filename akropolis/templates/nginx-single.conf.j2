{% if tls_enabled %}
# HTTP -> HTTPS redirect (with ACME challenge exception for certbot)
server {
    listen 80;
    server_name {{ hostname }};

    location /.well-known/acme-challenge/ {
        alias /var/www/akropolis-certbot/.well-known/acme-challenge/;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
{% endif %}

# nginx status endpoint - used by the monitoring tool
server {
    listen 8080;
    server_name _;
    location /nginx_status {
        stub_status;
        allow 127.0.0.1;
{% for cidr in stub_status_allow %}
        allow {{ cidr }};
{% endfor %}
        deny all;
    }
}

{% if tls_enabled %}
# HTTPS reverse proxy -> Authentik (its own HTTPS listener, 9443, loopback-only)
server {
    listen 443 ssl;
    server_name {{ hostname }};

    ssl_certificate     /etc/nginx/akropolis-certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/akropolis-certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
{% else %}
# tls provider "none": plain HTTP reverse proxy (testing only), targets
# Authentik's plain HTTP listener (9000, loopback-only)
server {
    listen 80;
    server_name _;
{% endif %}

    location / {
        proxy_pass         {% if tls_enabled %}https://127.0.0.1:9443{% else %}http://127.0.0.1:9000{% endif %};
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_http_version 1.1;
{% if tls_enabled %}
        proxy_ssl_verify   off;
{% endif %}
        proxy_buffer_size  128k;
        proxy_buffers      4 256k;
        proxy_read_timeout 90s;

        # Authentik unreachable (akropolis shutdown, or an actual outage) ->
        # a friendly page instead of nginx's bare error body. No `=200`
        # override: the real 502/503/504 status is kept, so uptime/alerting
        # monitoring still correctly sees the outage — only what a human
        # looking at a browser sees changes.
        proxy_intercept_errors on;
        error_page 502 503 504 /maintenance.html;
    }

    location = /maintenance.html {
        root /var/www/akropolis-maintenance;
    }
}
