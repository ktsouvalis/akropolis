# ============================================================
#  Authentik Single-Node Monitor — Site Configuration
#  Emitted by akropolis handoff for site: {{ site_name }}
#  Generated {{ generated_at }} — hand-edits survive until the next handoff run.
# ============================================================

site_name: "{{ site_title }}"
topology: "single"

unicode_bullets: true
refresh_interval: 20
http_timeout: 5

nodes:
  authentik:
    - ip: "{{ node.ip }}"
      name: "{{ node.name }}"

ports:
  # The bare-metal nginx in front of the node — this is the port the public
  # (and this probe) actually hits, not authentik's own container port.
  authentik: {{ authentik_port }}
  # Authentik WORKER liveness — a SEPARATE port (9081), never {{ authentik_port }}:
  # the worker binds its own HTTP listener so it does not squat the server's.
  authentik_worker: 9081
  nginx_status: 8080

scheme:
  # https on {{ authentik_port }}, or plain http for tls.provider 'none' (testing only)
  authentik: "{{ authentik_scheme }}"
  authentik_worker: "http"             # worker liveness is plain HTTP on 9081
  # Emitted false always, whatever tls.provider is: the monitor probes the
  # node at its IP and no certificate here names an IP, so verification
  # cannot succeed whoever issued it. Set true only if the node presents a
  # cert that names the address you dial.
  verify_tls: {{ 'true' if verify_tls else 'false' }}

ssh:
  username: "{{ ssh_user }}"
  key_file: "{{ ssh_key_file }}"

# Services to collect logs from.
# type: "docker" (container name) or "systemd" (unit name)
# nodes: key from the nodes section above that lists the target host(s)
services:
  - label: "Auth Server"
    nodes: authentik
    type: docker
    container: "authentik-server-1"
  - label: "Auth Worker"
    nodes: authentik
    type: docker
    container: "authentik-worker-1"
  - label: "PostgreSQL"
    nodes: authentik
    type: docker
    container: "authentik-postgresql-1"
  - label: "Reverse Proxy"
    nodes: authentik
    type: systemd
    unit: "nginx"

authentik:
  url: "{{ authentik_url }}"

credentials:
  authentik_api_token: "{{ api_token }}"
{% if cert_expiry %}

# NOTE: tls provider 'import' has no auto-renewal — certificate expires {{ cert_expiry }}.
{% endif %}
