services:
  postgresql:
    image: docker.io/library/postgres:16-alpine
    restart: unless-stopped
    env_file:
      - .env
    environment:
      POSTGRES_DB: ${PG_DB:-authentik}
      POSTGRES_USER: ${PG_USER:-authentik}
      POSTGRES_PASSWORD: ${PG_PASS:?database password required}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -d $${POSTGRES_DB} -U $${POSTGRES_USER}"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 20s
    volumes:
      - database:/var/lib/postgresql/data
    # Loopback-only: reachable from server/worker (network_mode: host, so
    # they see this as 127.0.0.1:5432 same as an HA node reaches its local
    # HAProxy) without ever being reachable off this host.
    ports:
      - "127.0.0.1:5432:5432"

  server:
    command: server
    depends_on:
      postgresql:
        condition: service_healthy
      worker:
        condition: service_healthy
    image: ghcr.io/goauthentik/server:${AUTHENTIK_TAG}
    restart: unless-stopped
    # non-root inside the image ("Not running as root, disabling permission
    # fixes" at boot) — binding 443 (a privileged port, <1024) needs this
    # capability, not full root the way the worker gets it for the docker
    # socket. Confirmed against a real crash: run_tls(server, 0.0.0.0:443)
    # failing with "Permission denied (os error 13)" without it.
    cap_add:
      - NET_BIND_SERVICE
    healthcheck:
      test: ["CMD", "python3", "-c", "import urllib.request,ssl,sys; ctx=ssl.create_default_context(); ctx.check_hostname=False; ctx.verify_mode=ssl.CERT_NONE; sys.exit(0) if urllib.request.urlopen('https://localhost:443/-/health/live/', timeout=5, context=ctx).status == 200 else sys.exit(1)"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    env_file:
      - .env
    volumes:
      - /opt/authentik/data:/media
      - /opt/authentik/custom-templates:/templates
{% for v in extra_server_volumes %}
      - {{ v }}
{% endfor %}
    network_mode: host

  worker:
    command: worker
    depends_on:
      postgresql:
        condition: service_healthy
    image: ghcr.io/goauthentik/server:${AUTHENTIK_TAG}
    restart: unless-stopped
    environment:
      # Same reasoning as the HA cluster's worker: under network_mode: host
      # it would otherwise squat the server's 9080/9300 by starting first.
      # HTTPS needs the same override here that the HA cluster's worker is
      # missing (see NOTES.md) — there it fails silently on a non-fatal
      # HTTP-only bind; here it inherits 443 from the shared .env, and a
      # failed TLS bind is fatal to the Rust arbiter, crash-looping the
      # server. Point the worker's HTTPS at an unused port instead.
      AUTHENTIK_LISTEN__HTTP: 0.0.0.0:9081
      AUTHENTIK_LISTEN__HTTPS: 0.0.0.0:9444
      AUTHENTIK_LISTEN__METRICS: 0.0.0.0:9301
    healthcheck:
      test: ["CMD", "python3", "-c", "import urllib.request,sys; sys.exit(0) if urllib.request.urlopen('http://localhost:9081/-/health/live/', timeout=5).status == 200 else sys.exit(1)"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    user: root
    env_file:
      - .env
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - /opt/authentik/data:/media
      - /opt/authentik/certs:/certs
{% for v in extra_worker_volumes %}
      - {{ v }}
{% endfor %}
    network_mode: host

volumes:
  database:
    driver: local
